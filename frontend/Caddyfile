# Serves the built React app and forwards API and WebSocket traffic to Django, on one origin.
# SITE_ADDRESS defaults to plain HTTP on port 80; set it to a domain for automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /ws/* {
		reverse_proxy web:8000
	}

	handle /api/* {
		reverse_proxy web:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
